# 第 4.2 课：LLM Provider 配置示例。
# 不要把真实密钥写进代码，也不要提交 .env。
# 使用时复制本文件为 .env，再填写真实值。

# 可选值：volcengine_agent_plan / volcengine_coding / deepseek / ollama
# volcengine_coding 是旧别名，后续统一使用 volcengine_agent_plan。
LLM_PROVIDER=volcengine_agent_plan

# 火山引擎 Ark Agent Plan。
# Agent Plan 使用专属 API Key 和专属 base URL，不要和普通火山方舟 API Key 混用。
VOLCENGINE_AGENT_PLAN_API_KEY=
VOLCENGINE_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VOLCENGINE_AGENT_PLAN_MODEL=ark-code-latest

# DeepSeek。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama 本地模型。
# 先在本机启动 ollama，再把 LLM_PROVIDER 改成 ollama。
# OpenAI 兼容接口通常使用 /v1。
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Ollama 本地 embedding 模型。
# 需要先执行类似 `ollama pull mxbai-embed-large`，或改成你本机已启用的 embedding 模型。
# 这里使用原生 Ollama 地址，不使用 OpenAI 兼容的 /v1 路径。
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
